{
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.kamalmedicalhall.com",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "EXPO_PUBLIC_ENV": "preview"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.kamalmedicalhall.com",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "EXPO_PUBLIC_ENV": "production"
      }
    },
    "hardened": {
      "extends": "preview",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.kamalmedicalhall.com",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "EXPO_PUBLIC_ENV": "preview",
        "ENABLE_R8": "true"
      }
    }
  }
}